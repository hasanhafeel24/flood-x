# ==============================================================================
# FLOOD-X .gitignore
# ==============================================================================

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo
*.pyd
*.pyc

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
virtualenv/

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
out/
build/
*.local
.DS_Store

# ── Environment / Secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ── IDE / Editor ───────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Database ───────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
pgdata/

# ── ML Models (large binaries) ────────────────────────────────────────────────
# Committed model checkpoints only if small and intentional
models/*.pkl
models/*.joblib
models/*.bin
models/*.pt
models/*.pth
# Allow metadata and evaluation results
!models/*.json
!models/*.md

# ── Data (large files) ─────────────────────────────────────────────────────────
data/raw/*.tif
data/raw/*.tiff
data/raw/*.nc
data/raw/*.grib
data/raw/*.hdf5
# Allow synthetic sample data (small GeoJSON, CSV)
!data/synthetic/**
!data/sample/**

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Notebooks (outputs) ────────────────────────────────────────────────────────
notebooks/.ipynb_checkpoints/
