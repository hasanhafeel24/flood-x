# ==============================================================================
# FLOOD-X Environment Configuration — Production Example
# ==============================================================================
# For Render deployment, set these via the Render Dashboard → Environment panel.
# Do NOT create a .env file on the Render server — use environment variables.
#
# For Vercel, set VITE_* variables via the Vercel Dashboard → Settings → Env.
#
# Keys marked [REQUIRED] must be set before the service starts.
# Keys marked [AUTO] are set automatically by Render.
# Keys marked [OPTIONAL] have safe defaults.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false                          # [REQUIRED] Must be false in production
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ── Backend Server ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
# PORT is injected by Render automatically — do not set this manually  [AUTO]
# BACKEND_PORT is ignored when PORT is set by Render
BACKEND_RELOAD=false

# ── Database ───────────────────────────────────────────────────────────────────
# [REQUIRED] — Copy "Internal Database URL" from Render PostgreSQL dashboard
# Change scheme: postgresql:// → postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://floodx:CHANGE_ME@RENDER_DB_HOST:5432/floodx

# [REQUIRED for Alembic migrations] — use psycopg2 (sync) driver
# Change scheme: postgresql:// → postgresql+psycopg2://
DATABASE_SYNC_URL=postgresql+psycopg2://floodx:CHANGE_ME@RENDER_DB_HOST:5432/floodx

# ── Security ───────────────────────────────────────────────────────────────────
# [REQUIRED] Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_SECURE_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────
# [REQUIRED] Replace with your actual Vercel deployment URL
# Multiple origins: comma-separated (no spaces)
CORS_ORIGINS=https://YOUR-APP-NAME.vercel.app

# ── Data Providers ─────────────────────────────────────────────────────────────
# Use synthetic mode for production (no external API keys required)
RAINFALL_PROVIDER=synthetic
TERRAIN_PROVIDER=synthetic
DRAINAGE_PROVIDER=synthetic

# ── IMD Provider (optional — comment out if not using) ────────────────────────
# IMD_API_KEY=your_institutional_imd_api_key_here
# IMD_API_URL=https://imdpune.gov.in/api/

# ── Simulation ─────────────────────────────────────────────────────────────────
SIMULATION_TICK_SECONDS=5
SIMULATION_SPEED_MULTIPLIER=1.0
DEFAULT_SCENARIO=normal_rainfall

# ── Geospatial ─────────────────────────────────────────────────────────────────
DEFAULT_CRS=EPSG:4326
PILOT_CITY=Chennai
PILOT_BBOX_WEST=80.15
PILOT_BBOX_SOUTH=12.90
PILOT_BBOX_EAST=80.32
PILOT_BBOX_NORTH=13.10

# ── ML Models ─────────────────────────────────────────────────────────────────
# In Render deployment, models/ is at the root of backend/
ML_MODELS_DIR=./models
ML_PRIMARY_MODEL=xgboost_v1
ML_CONFIDENCE_THRESHOLD=0.5

# ==============================================================================
# VITE FRONTEND VARIABLES (set in Vercel Dashboard → Settings → Environment)
# These are baked into the static build — they must be set BEFORE deploying.
# DO NOT include backend secrets in VITE_* variables.
# ==============================================================================

# [REQUIRED] Your Render backend public URL (no trailing slash)
VITE_API_BASE_URL=https://flood-x-api.onrender.com

# [REQUIRED] WebSocket endpoint — use wss:// for production
VITE_WS_URL=wss://flood-x-api.onrender.com/ws

VITE_APP_NAME=FLOOD-X
VITE_APP_ENV=production

# [OPTIONAL] MapTiler API key for premium map styles
# Leave empty to use free OpenFreeMap tiles (no key required)
VITE_MAPTILER_KEY=
