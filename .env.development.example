# ==============================================================================
# FLOOD-X Environment Configuration — Development Example
# ==============================================================================
# Copy to .env for local development:
#   cp .env.development.example .env
#
# NEVER commit .env to version control.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=FLOOD-X
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG

# ── Backend Server ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ── Database (local PostgreSQL via Docker Compose) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://floodx:floodx_dev_password@localhost:5432/floodx
DATABASE_SYNC_URL=postgresql+psycopg2://floodx:floodx_dev_password@localhost:5432/floodx
POSTGRES_USER=floodx
POSTGRES_PASSWORD=floodx_dev_password
POSTGRES_DB=floodx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Security (dev value — never use in production) ─────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-never-use-this-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS (local frontend ports) ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── Data Providers ─────────────────────────────────────────────────────────────
# Options: synthetic | file | imd
RAINFALL_PROVIDER=synthetic
TERRAIN_PROVIDER=synthetic
DRAINAGE_PROVIDER=synthetic

# ── Simulation ─────────────────────────────────────────────────────────────────
SIMULATION_TICK_SECONDS=5
SIMULATION_SPEED_MULTIPLIER=1.0
DEFAULT_SCENARIO=normal_rainfall

# ── Geospatial ─────────────────────────────────────────────────────────────────
DEFAULT_CRS=EPSG:4326
PILOT_CITY=Chennai
PILOT_BBOX_WEST=80.15
PILOT_BBOX_SOUTH=12.90
PILOT_BBOX_EAST=80.32
PILOT_BBOX_NORTH=13.10

# ── ML Models ─────────────────────────────────────────────────────────────────
ML_MODELS_DIR=../models
ML_PRIMARY_MODEL=xgboost_v1
ML_CONFIDENCE_THRESHOLD=0.5

# ── Frontend (Vite build-time — prefix VITE_) ─────────────────────────────────
# Points to local backend during development
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=FLOOD-X
VITE_APP_ENV=development
# MapTiler key (optional — leave empty to use free OpenFreeMap tiles)
VITE_MAPTILER_KEY=
